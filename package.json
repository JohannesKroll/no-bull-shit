{
  "name": "no-bullshit-services",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build && playwright test",
    "social-image": "node scripts/create-social-image.js",
    "firebase:login": "npx --yes firebase-tools@15.30.0 login",
    "hosting:check": "npm run build && npx --yes firebase-tools@15.30.0 emulators:exec --only hosting --project demo-no-bullshit \"node scripts/check-hosting.js\"",
    "deploy": "npx --yes firebase-tools@15.30.0 deploy --only hosting --project no-bull-shit-bb344"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "simple-icons": "^16.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "vite": "^7.1.0"
  }
}
